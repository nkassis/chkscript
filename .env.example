# Copy to .env and fill in. Never commit the copy.
# chkscript never loads .env itself; use your shell or `uv run --env-file .env`.
# Placeholders only, never a real value.

# Provider secrets (names the SDKs already read). Each *_API_KEY may instead be
# given as *_API_KEY_FILE=/path/to/file (Docker secrets / systemd credentials).
ANTHROPIC_API_KEY=replace-me
# ANTHROPIC_API_KEY_FILE=/run/secrets/anthropic_api_key
OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://api.example.invalid/v1
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_API_KEY=replace-me

# chkscript selection and limits (flags override these).
CHKSCRIPT_MODEL=replace-me
CHKSCRIPT_DEPTH=2
CHKSCRIPT_MAX_FETCHES=5
CHKSCRIPT_FAIL_ON=warning
CHKSCRIPT_NO_FOLLOW=0
